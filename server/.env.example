# Copy this file to .env and fill in the values.

PORT=4000
# Public URL of your website (used for payment redirects)
APP_URL=https://yourdomain.com

# (Docker Compose sets this for you: database "jirex", user "jirex")
DATABASE_URL=postgres://jirex:change-me@localhost:5432/jirex

# Generate both with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ENCRYPTION_KEY=

# The account that registers with this email becomes the admin
ADMIN_EMAIL=desireasiimwe24@gmail.com

# How many devices one paying customer can connect
MAX_DEVICES=5

# Currency for all prices (prices are set in Admin → Settings → Plans & prices)
CURRENCY=RUB

# Where payment receipts are stored. Back this folder up!
UPLOAD_DIR=./uploads

# Outgoing email for verification and sign-in codes (required on the live server).
# Use your mailbox's SMTP details. Keep the password only in server/.env, never here.
SMTP_HOST=mail.lwegatech.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=desire@lwegatech.net
SMTP_PASS=
MAIL_FROM='JIREX <desire@lwegatech.net>'

# Bank details shown to customers for transfers are set in the website:
# Admin -> Settings.

# ---- Hosting without a lasting disk or a VPN server (e.g. Vercel, for testing) ----
# Keep receipts (encrypted) in the database instead of UPLOAD_DIR. Automatic on Vercel.
# RECEIPT_STORAGE=database
# Add a simulated "JIRE SERVER" when there are no servers, so devices can be tried out.
# DEMO_SERVER=1
# Lets the scheduled cleanup run at /api/cron/maintenance (Vercel Cron sends it automatically).
# CRON_SECRET=
# Database connections per server process (use 3 on Vercel).
# PG_POOL_MAX=10
